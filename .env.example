# Copy this file to .env.local and adjust. NEVER commit .env.local or real secrets.
# Generate a secret with:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'

APP_ENV=dev
APP_SECRET=replace_with_a_long_random_string

# SQLite (default, zero setup)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# MySQL example (placeholders only)
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/carrent?serverVersion=8.0&charset=utf8mb4"

# Local mail catcher (e.g. Mailpit) – replace with a real SMTP DSN in production
MAILER_DSN=smtp://localhost:1025
