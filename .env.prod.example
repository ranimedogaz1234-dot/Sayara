# Production environment reference. This file is never read by Symfony and
# must never be copied into a tracked file.
#
# Set these as real environment variables on your host (the preferred way:
# most platforms - systemd, Docker, PaaS dashboards - have a dedicated place
# for them), or copy this file to .env.prod.local and fill in real values
# there. .env.prod.local is already excluded by .gitignore (the existing
# /.env.*.local pattern covers it) - but a real secret belongs in your host's
# secret storage even then, not in a file sitting on disk.
#
# Generate APP_SECRET with:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'

APP_ENV=prod
# Symfony's Dotenv component already defaults APP_DEBUG to 0 whenever
# APP_ENV=prod (see vendor/symfony/dotenv/Dotenv.php, bootEnv()). It is set
# explicitly here anyway: a committed reference file should not rely on a
# default a future reader might not know about.
APP_DEBUG=0
APP_SECRET=replace_with_a_long_random_string

# Point this at your production database. SQLite can be fine for a small
# single-server deployment; for anything beyond that, use a real MySQL or
# PostgreSQL server reachable from the application host.
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/carrent?serverVersion=8.0&charset=utf8mb4"

# A real SMTP DSN so reservation confirmation e-mails are actually delivered.
MAILER_DSN=smtp://user:pass@smtp.example.com:587
