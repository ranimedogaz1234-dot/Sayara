{% set route = app.request.attributes.get('_route') %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}CarRent{% endblock %} — CarRent</title>
    <meta name="description" content="{% block description %}CarRent — a curated fleet of luxury cars, available to rent by the day.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/luxury.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="luxury-body">

{# Transparent over the homepage hero, solid everywhere else. #}
{% set navTransparent = block('nav_transparent') is defined and block('nav_transparent')|trim == 'yes' %}
<nav class="lx-nav {{ navTransparent ? '' : 'is-solid' }}" data-transparent="{{ navTransparent ? 'true' : 'false' }}" aria-label="Main">
    <div class="container">
        <a class="lx-brand" href="{{ path('app_home') }}">CarRent</a>

        <button class="lx-burger" type="button" data-toggle="collapse" data-target="#lxNav" aria-controls="lxNav" aria-expanded="false" aria-label="Menu">
            <span></span><span></span>
        </button>

        <div class="collapse lx-collapse" id="lxNav">
            <ul class="lx-menu">
                <li><a href="{{ path('app_catalog') }}" class="{{ route in ['app_catalog', 'app_catalog_show'] ? 'is-active' }}">Fleet</a></li>
                <li><a href="{{ path('app_home') }}#marques">Marques</a></li>
                <li><a href="{{ path('app_about') }}" class="{{ route == 'app_about' ? 'is-active' }}">About</a></li>
                <li><a href="{{ path('app_contact') }}" class="{{ route == 'app_contact' ? 'is-active' }}">Contact</a></li>
            </ul>

            <div class="lx-actions">
                {% if app.user %}
                    <div class="dropdown lx-account">
                        <button class="btn-lx btn-lx--outline btn-lx--sm dropdown-toggle" type="button" id="lxAccount" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ is_granted('ROLE_ADMIN') ? 'Dashboard' : 'My account' }}
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="lxAccount">
                            <div class="dropdown-header">
                                <span class="meta">Signed in as</span>
                                <strong title="{{ app.user.nom }}">{{ app.user.nom }}</strong>
                            </div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="dropdown-item" href="{{ path('app_dashboard') }}">Admin dashboard</a>
                            {% else %}
                                <a class="dropdown-item" href="{{ path('app_profile') }}">My account</a>
                            {% endif %}
                            <a class="dropdown-item" href="{{ path('app_reservation_index') }}">My bookings</a>
                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#crLogoutModal">Sign out</a>
                        </div>
                    </div>
                {% else %}
                    <a class="lx-signin" href="{{ path('app_login') }}">Sign in</a>
                    <a class="btn-lx btn-lx--outline btn-lx--sm" href="{{ path('app_signup') }}">Register</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

{% set flashes = app.flashes(['success', 'error']) %}
{% if flashes.success is not empty or flashes.error is not empty %}
    <div class="lx-flash" role="status">
        {% for message in flashes.success %}
            <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button></div>
        {% endfor %}
        {% for message in flashes.error %}
            <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span>&times;</span></button></div>
        {% endfor %}
    </div>
{% endif %}

<main class="{% block main_class %}{% endblock %}">
    {% block body %}{% endblock %}
</main>

<footer class="lx-footer">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-5 mb-lg-0">
                <a class="lx-brand" href="{{ path('app_home') }}">CarRent</a>
                <p class="mt-4 mb-0" style="max-width: 300px;">A curated fleet of exceptional cars, rented by the day — with transparent pricing and bookings that stay private to you.</p>
            </div>
            <div class="col-6 col-lg-2 offset-lg-1 mb-5 mb-lg-0">
                <h6>Explore</h6>
                <ul>
                    <li><a href="{{ path('app_catalog') }}">The fleet</a></li>
                    <li><a href="{{ path('app_home') }}#marques">Marques</a></li>
                    <li><a href="{{ path('app_about') }}">About</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2 mb-5 mb-lg-0">
                <h6>Account</h6>
                <ul>
                    {% if app.user %}
                        <li><a href="{{ path('app_reservation_index') }}">My bookings</a></li>
                        <li><a href="{{ path('app_profile') }}">My account</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Sign in</a></li>
                        <li><a href="{{ path('app_signup') }}">Register</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-lg-3">
                <h6>Contact</h6>
                <ul>
                    <li>contact@carrent.example</li>
                    <li>+33 1 00 00 00 00</li>
                    <li><a href="{{ path('app_contact') }}">Contact page</a></li>
                </ul>
            </div>
        </div>
        <div class="lx-footer__base">
            <span>&copy; {{ "now"|date("Y") }} CarRent. All rights reserved.</span>
            <a href="{{ path('app_credits') }}">Photography credits</a>
        </div>
    </div>
</footer>

{% if app.user %}
<div class="modal fade" id="crLogoutModal" tabindex="-1" role="dialog" aria-labelledby="crLogoutTitle">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crLogoutTitle">Sign out</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">Are you sure you want to sign out of CarRent?</div>
            <div class="modal-footer">
                <button class="btn-lx btn-lx--outline btn-lx--sm" type="button" data-dismiss="modal">Cancel</button>
                <a class="btn-lx btn-lx--gold btn-lx--sm" href="{{ logout_path() }}">Sign out</a>
            </div>
        </div>
    </div>
</div>
{% endif %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        // Transparent nav over the hero becomes solid once the page scrolls.
        var nav = document.querySelector('.lx-nav');
        if (nav && nav.dataset.transparent === 'true') {
            var update = function () { nav.classList.toggle('is-solid', window.scrollY > 40); };
            update();
            window.addEventListener('scroll', update, { passive: true });
            // Opening the mobile menu over the hero needs a solid backdrop.
            $('#lxNav').on('show.bs.collapse', function () { nav.classList.add('is-solid'); })
                       .on('hidden.bs.collapse', update);
        }

        // Reveal-on-scroll. Content is visible by default; this only adds a
        // fade when IntersectionObserver exists and motion is allowed.
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('.cr-reveal:not(.cr-visible)');
        if (reduce || !('IntersectionObserver' in window)) {
            items.forEach(function (el) { el.classList.add('cr-visible'); });
        } else {
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) { e.target.classList.add('cr-visible'); io.unobserve(e.target); }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            items.forEach(function (el) { io.observe(el); });
        }

        // Flash messages fade out on their own after a few seconds.
        setTimeout(function () { $('.lx-flash .alert').alert('close'); }, 6000);
    })();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
