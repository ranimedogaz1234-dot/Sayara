<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{% block title %}CarRent{% endblock %} — Luxury Car Rental</title>
    <link href="https://fonts.googleapis.com/css?family=Nunito:300,400,600,700,800,900" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/luxury.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="luxury-body">

<nav class="navbar navbar-expand-lg cr-nav">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Car<span>Rent</span></a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#crNavMain" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="crNavMain">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'app_catalog' ? 'active' }}" href="{{ path('app_catalog') }}">Our Fleet</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#brands">Car Brands</a></li>
                <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'app_about' ? 'active' }}" href="{{ path('app_about') }}">About Us</a></li>
                <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'app_contact' ? 'active' }}" href="{{ path('app_contact') }}">Contact</a></li>
            </ul>
            <ul class="navbar-nav ml-auto align-items-lg-center">
                {% if app.user %}
                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle" href="#" id="crUserDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-user-circle mr-1"></i>{{ app.user.nom }}
                        </a>
                        <div class="dropdown-menu dropdown-menu-right cr-dropdown-menu" aria-labelledby="crUserDropdown">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="dropdown-item" href="{{ path('app_dashboard') }}"><i class="fas fa-tachometer-alt mr-2"></i>Dashboard</a>
                                <div class="dropdown-divider" style="border-color: var(--cr-border);"></div>
                            {% else %}
                                <a class="dropdown-item" href="{{ path('app_profile') }}"><i class="fas fa-user mr-2"></i>My Account</a>
                            {% endif %}
                            <a class="dropdown-item" href="{{ path('app_reservation_index') }}"><i class="fas fa-calendar-alt mr-2"></i>My Bookings</a>
                            <div class="dropdown-divider" style="border-color: var(--cr-border);"></div>
                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#crLogoutModal"><i class="fas fa-sign-out-alt mr-2"></i>Logout</a>
                        </div>
                    </li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Login</a></li>
                    <li class="nav-item ml-lg-2"><a class="btn-cr-primary" href="{{ path('app_signup') }}">Register</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main>
    <div class="container pt-4">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show cr-reveal cr-visible" role="alert">
                <i class="fas fa-check-circle mr-2"></i>{{ message }}
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show cr-reveal cr-visible" role="alert">
                <i class="fas fa-exclamation-circle mr-2"></i>{{ message }}
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        {% endfor %}
    </div>

    {% block body %}{% endblock %}
</main>

<footer class="cr-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4 mb-md-0">
                <h6>CarRent</h6>
                <p class="small mb-0">Dubai-grade luxury car rental — built as a Symfony portfolio project. Rent extraordinary vehicles with a refined, modern experience.</p>
            </div>
            <div class="col-md-4 mb-4 mb-md-0">
                <h6>Quick Links</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="{{ path('app_home') }}">Home</a></li>
                    <li class="mb-2"><a href="{{ path('app_catalog') }}">Our Fleet</a></li>
                    <li class="mb-2"><a href="{{ path('app_about') }}">About Us</a></li>
                    <li class="mb-2"><a href="{{ path('app_contact') }}">Contact</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h6>Contact</h6>
                <p class="small mb-1"><i class="fas fa-envelope mr-2"></i>contact@carrent.example</p>
                <p class="small mb-0"><i class="fas fa-phone mr-2"></i>+33 1 00 00 00 00</p>
            </div>
        </div>
        <div class="cr-copy">&copy; {{ "now"|date("Y") }} CarRent. All rights reserved.</div>
    </div>
</footer>

{% if app.user %}
<div class="modal fade" id="crLogoutModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="background: var(--cr-black-card); border: 1px solid var(--cr-border); color: #fff;">
            <div class="modal-header" style="border-color: var(--cr-border);">
                <h5 class="modal-title">Confirm logout</h5>
                <button class="close text-white" type="button" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">Are you sure you want to log out of CarRent?</div>
            <div class="modal-footer" style="border-color: var(--cr-border);">
                <button class="btn-cr-outline" type="button" data-dismiss="modal">Cancel</button>
                <a class="btn-cr-primary" href="{{ logout_path() }}">Logout</a>
            </div>
        </div>
    </div>
</div>
{% endif %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>
<script>
    // Reveal-on-scroll: progressive enhancement only. Elements are visible
    // by default (see .cr-reveal in luxury.css); if IntersectionObserver is
    // unavailable or prefers-reduced-motion is set, they simply stay visible
    // with no animation, never hidden.
    (function () {
        var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('.cr-reveal');
        if (prefersReduced || !('IntersectionObserver' in window)) {
            items.forEach(function (el) { el.classList.add('cr-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('cr-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        items.forEach(function (el) { observer.observe(el); });
    })();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
