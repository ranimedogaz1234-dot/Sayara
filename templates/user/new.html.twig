{% extends 'base.html.twig' %}
{% block title %}Ajouter un Client{% endblock %}
{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-user-plus text-success mr-2"></i>Ajouter un Client</h1>
    <a href="{{ path('app_user_index') }}" class="btn btn-secondary shadow-sm"><i class="fas fa-arrow-left fa-sm mr-1"></i>Retour</a>
</div>
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow mb-4">
            <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-success"><i class="fas fa-user mr-2"></i>Informations du Client</h6></div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="form-group">
                    <label class="font-weight-bold text-gray-700"><i class="fas fa-user mr-1 text-success"></i> Nom Complet</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom et prénom...'}}) }}
                    {{ form_errors(form.nom) }}
                </div>
                <div class="form-group">
                    <label class="font-weight-bold text-gray-700"><i class="fas fa-envelope mr-1 text-success"></i> Email</label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'email@exemple.com'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="form-group">
                    <label class="font-weight-bold text-gray-700"><i class="fas fa-lock mr-1 text-success"></i> Mot de passe</label>
                    {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le mot de passe...'}}) }}
                    {{ form_errors(form.password) }}
                </div>
                <hr class="my-4">
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary"><i class="fas fa-times mr-1"></i>Annuler</a>
                    <button type="submit" class="btn btn-success px-4"><i class="fas fa-save mr-1"></i>Enregistrer</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
