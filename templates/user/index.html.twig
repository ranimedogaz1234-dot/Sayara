{% extends 'base.html.twig' %}

{% block title %}Liste des Clients{% endblock %}

{% block body %}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-users text-success mr-2"></i>Liste des Clients
    </h1>
    <a href="{{ path('app_user_new') }}" class="btn btn-success shadow-sm">
        <i class="fas fa-user-plus fa-sm mr-1"></i> Ajouter un Client
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-success">
            <i class="fas fa-table mr-2"></i>Clients Enregistrés
            <span class="badge badge-success ml-2">{{ users|length }}</span>
        </h6>
    </div>
    <div class="card-body">
        {% if users|length == 0 %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-users fa-4x mb-3"></i>
                <p class="h5">Aucun client enregistré.</p>
                <a href="{{ path('app_user_new') }}" class="btn btn-success mt-2">
                    <i class="fas fa-user-plus mr-1"></i>Ajouter le premier client
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%">
                    <thead class="thead-dark">
                    <tr>
                        <th width="60">#</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th width="220" class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="text-center font-weight-bold text-success">{{ user.id }}</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name={{ user.nom|url_encode }}&background=1cc88a&color=fff&size=32"
                                         class="rounded-circle mr-2" width="32" height="32">
                                    <strong>{{ user.nom }}</strong>
                                </div>
                            </td>
                            <td>
                                <i class="fas fa-envelope text-muted mr-1"></i>{{ user.email }}
                            </td>
                            <td>
                                <span class="badge badge-secondary px-2 py-1">{{ user.role }}</span>
                            </td>
                            <td class="text-center">
                                <a href="{{ path('app_user_show', {id: user.id}) }}"
                                   class="btn btn-info btn-sm mr-1" title="Consulter">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_user_edit', {id: user.id}) }}"
                                   class="btn btn-warning btn-sm mr-1" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm"
                                        title="Supprimer"
                                        data-toggle="modal" data-target="#deleteModal{{ user.id }}">
                                    <i class="fas fa-trash"></i>
                                </button>

                                <!-- Modal Suppression -->
                                <div class="modal fade" id="deleteModal{{ user.id }}" tabindex="-1" role="dialog">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title">
                                                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmer la suppression
                                                </h5>
                                                <button class="close text-white" type="button" data-dismiss="modal">
                                                    <span>&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                Voulez-vous vraiment supprimer le client
                                                <strong>{{ user.nom }}</strong> ?
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-secondary" type="button" data-dismiss="modal">
                                                    <i class="fas fa-times mr-1"></i>Annuler
                                                </button>
                                                <form method="post" action="{{ path('app_user_delete', {id: user.id}) }}" style="display:inline">
                                                    <input type="hidden" name="_method" value="DELETE">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                    <button class="btn btn-danger" type="submit">
                                                        <i class="fas fa-trash mr-1"></i>Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}
