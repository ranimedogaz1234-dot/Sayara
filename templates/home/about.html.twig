{% extends 'base_public.html.twig' %}

{% block title %}About Us{% endblock %}

{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="cr-section-title cr-reveal cr-visible">
            <h2>About CarRent</h2>
            <div class="cr-underline"></div>
        </div>
        <div class="row justify-content-center cr-reveal cr-visible">
            <div class="col-lg-8">
                <div class="cr-panel cr-panel-body">
                    <p class="mb-3">CarRent is a premium vehicle rental platform built to make booking a high-end car simple, transparent and secure.</p>
                    <ul class="list-unstyled" style="color: var(--cr-gray-300);">
                        <li class="mb-2"><i class="fas fa-check mr-2 text-white-50"></i>Competitive, transparent daily pricing</li>
                        <li class="mb-2"><i class="fas fa-check mr-2 text-white-50"></i>A well-maintained, available fleet</li>
                        <li class="mb-2"><i class="fas fa-check mr-2 text-white-50"></i>A simple, secure booking flow from browsing to confirmation</li>
                        <li class="mb-2"><i class="fas fa-check mr-2 text-white-50"></i>Your account and reservation data kept private and secure</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
