{% extends 'base_public.html.twig' %}

{% block title %}Contact Us{% endblock %}

{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="cr-section-title cr-reveal cr-visible">
            <h2>Contact Us</h2>
            <div class="cr-underline"></div>
            <p>We're happy to help with any question about your reservation.</p>
        </div>
        <div class="row justify-content-center cr-reveal cr-visible">
            <div class="col-lg-6">
                <div class="cr-panel cr-panel-body text-center">
                    <p class="mb-3"><i class="fas fa-envelope mr-2"></i>contact@carrent.example</p>
                    <p class="mb-0"><i class="fas fa-phone mr-2"></i>+33 1 00 00 00 00</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
