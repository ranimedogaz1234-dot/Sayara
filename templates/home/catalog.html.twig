{% extends 'base_public.html.twig' %}

{% block title %}Our Fleet{% endblock %}

{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="cr-section-title cr-reveal cr-visible">
            <h2>Our Fleet</h2>
            <div class="cr-underline"></div>
            <p>{{ voitures|length }} vehicle{{ voitures|length != 1 ? 's' }} available{% if currentBrand %} — {{ currentBrand }}{% endif %}</p>
        </div>

        <form class="cr-filter-bar cr-reveal cr-visible" method="get" action="{{ path('app_catalog') }}">
            <div class="form-group flex-grow-1" style="min-width:180px;">
                <label for="filterQ">Search</label>
                <input type="text" id="filterQ" name="q" class="form-control cr-input" placeholder="Brand or model..." value="{{ currentQuery }}">
            </div>
            <div class="form-group" style="min-width:160px;">
                <label for="filterBrand">Brand</label>
                <select id="filterBrand" name="brand" class="form-control cr-input">
                    <option value="">All brands</option>
                    {% for brand in brands %}
                        <option value="{{ brand }}" {{ currentBrand == brand ? 'selected' }}>{{ brand }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group" style="min-width:160px;">
                <label for="filterSort">Sort by</label>
                <select id="filterSort" name="sort" class="form-control cr-input">
                    <option value="price_asc" {{ currentSort == 'price_asc' ? 'selected' }}>Price: Low to High</option>
                    <option value="price_desc" {{ currentSort == 'price_desc' ? 'selected' }}>Price: High to Low</option>
                    <option value="name" {{ currentSort == 'name' ? 'selected' }}>Brand name</option>
                </select>
            </div>
            {% if pickupDate %}<input type="hidden" name="pickupDate" value="{{ pickupDate }}">{% endif %}
            {% if returnDate %}<input type="hidden" name="returnDate" value="{{ returnDate }}">{% endif %}
            <div class="form-group">
                <button type="submit" class="btn-cr-primary">Apply</button>
                <a href="{{ path('app_catalog') }}" class="btn-cr-outline ml-2">Reset</a>
            </div>
        </form>

        {% if voitures|length > 0 %}
            <div class="cr-grid">
                {% for voiture in voitures %}
                    {% include 'home/_car_card.html.twig' with {voiture: voiture, pickupDate: pickupDate, returnDate: returnDate} %}
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-danger cr-reveal cr-visible text-center py-5">
                <i class="fas fa-car-side fa-2x mb-3 d-block"></i>
                No vehicles match your search right now. Try adjusting your filters.
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
