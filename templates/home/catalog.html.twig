{% extends 'base_public.html.twig' %}

{% block title %}The fleet{% endblock %}

{% block body %}
{% include '_partials/page_header.html.twig' with {
    eyebrow: 'The fleet',
    title: currentBrand ? currentBrand : 'Our',
    em: 'collection',
    lede: voitures|length ~ (voitures|length == 1 ? ' car' : ' cars') ~ ' available' ~ (pickupDate and returnDate ? ' — your dates are carried through to booking.' : ', each bookable by the day.'),
} %}

<section class="lx-section--tight">
    <div class="container">
        {# Only real filters: brand/model search (q), make (brand), sort.
           Dates from the homepage search are kept as hidden fields. #}
        <form class="lx-search lx-search--wide cr-reveal cr-visible mb-5" method="get" action="{{ path('app_catalog') }}">
            <div class="lx-search__field">
                <label for="fQ">Search</label>
                <input type="text" id="fQ" name="q" placeholder="Make or model" value="{{ currentQuery }}">
            </div>
            <div class="lx-search__field">
                <label for="fBrand">Make</label>
                <select id="fBrand" name="brand">
                    <option value="">All makes</option>
                    {% for brand in brands %}<option value="{{ brand }}" {{ currentBrand == brand ? 'selected' }}>{{ brand }}</option>{% endfor %}
                </select>
            </div>
            <div class="lx-search__field">
                <label for="fSort">Sort by</label>
                <select id="fSort" name="sort">
                    <option value="price_asc" {{ currentSort == 'price_asc' ? 'selected' }}>Price, low to high</option>
                    <option value="price_desc" {{ currentSort == 'price_desc' ? 'selected' }}>Price, high to low</option>
                    <option value="name" {{ currentSort == 'name' ? 'selected' }}>Make, A to Z</option>
                </select>
            </div>
            <div class="lx-search__field">
                <label>Your dates</label>
                <span style="font-size:14px;color:var(--ivory-70);">
                    {% if pickupDate and returnDate %}{{ pickupDate|date('d M') }} — {{ returnDate|date('d M Y') }}{% else %}Choose on the car's page{% endif %}
                </span>
            </div>
            {% if pickupDate %}<input type="hidden" name="pickupDate" value="{{ pickupDate }}">{% endif %}
            {% if returnDate %}<input type="hidden" name="returnDate" value="{{ returnDate }}">{% endif %}
            <button type="submit" class="lx-search__submit">Apply</button>
        </form>

        {% if currentBrand or currentQuery %}
            <p class="meta mb-5">Filtered results &middot; <a href="{{ path('app_catalog') }}" style="color:var(--gold);">Clear filters</a></p>
        {% endif %}

        {% if voitures|length > 0 %}
            <div class="lx-grid">
                {% for voiture in voitures %}
                    {% include 'home/_car_card.html.twig' with {voiture: voiture, pickupDate: pickupDate, returnDate: returnDate} %}
                {% endfor %}
            </div>
        {% else %}
            <div class="lx-cta">
                <span class="eyebrow">No match</span>
                <h2 class="title">Nothing fits <em>those filters</em></h2>
                <a class="btn-lx btn-lx--outline" href="{{ path('app_catalog') }}">View every car</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
