{% extends 'base_public.html.twig' %}

{% block title %}CarRent{% endblock %}

{% block body %}
<section class="cr-hero">
    <div class="container text-center">
        <h1 class="cr-reveal cr-visible">Experience Luxury.<br>Drive Extraordinary.</h1>
        <p class="lead cr-reveal cr-visible">
            Choose from our finest selection of premium vehicles and embark on a journey of elegance.
        </p>

        {# Search bar. Return location has no backing field on Voiture (no
           location concept exists in the data model), so it is kept as a
           plain descriptive field rather than wired to a fake filter -
           see the PR description for this documented limitation. Dates
           are validated server-side in HomeController::catalog() and
           carried through to the vehicle list and "Book Now" links. #}
        <form class="cr-search cr-reveal cr-visible" action="{{ path('app_catalog') }}" method="get" style="max-width:980px;margin:0 auto;">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
                    <label for="searchQ">Vehicle / Brand</label>
                    <input type="text" id="searchQ" name="q" class="form-control cr-input" placeholder="e.g. BMW, Audi...">
                </div>
                <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
                    <label for="pickupDate">Pick-up Date</label>
                    <input type="date" id="pickupDate" name="pickupDate" class="form-control cr-input">
                </div>
                <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
                    <label for="returnDate">Return Date</label>
                    <input type="date" id="returnDate" name="returnDate" class="form-control cr-input">
                </div>
                <div class="col-lg-3 col-md-6 d-flex align-items-end">
                    <button type="submit" class="btn-cr-primary w-100">
                        <i class="fas fa-search mr-1"></i> Search Vehicles
                    </button>
                </div>
            </div>
        </form>

        {% if featuredVoitures|length > 0 %}
            <div class="cr-stage" data-controller="hero-carousel">
                <button type="button" class="cr-arrow cr-prev" data-action="hero-carousel#prev" aria-label="Previous vehicle">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button type="button" class="cr-arrow cr-next" data-action="hero-carousel#next" aria-label="Next vehicle">
                    <i class="fas fa-chevron-right"></i>
                </button>

                {% for voiture in featuredVoitures %}
                    <div class="cr-stage-slide {{ loop.first ? 'cr-active' }}" data-hero-carousel-target="slide">
                        {% if voiture.image %}
                            <div class="cr-stage-img-wrap">
                                <img src="{{ asset('uploads/voitures/' ~ voiture.image) }}" alt="{{ voiture.marque }} {{ voiture.modele }}">
                            </div>
                        {% else %}
                            <div class="cr-stage-fallback"><i class="fas fa-car-side"></i></div>
                        {% endif %}
                        <div class="cr-stage-ring"></div>
                        <div class="cr-stage-caption">
                            <h3>{{ voiture.marque }} {{ voiture.modele }}</h3>
                            <div class="price">{{ voiture.prixParJour }} DT / day</div>
                            <a href="{{ path('app_catalog_show', {id: voiture.id}) }}" class="btn-cr-outline mt-3 d-inline-block">View Details</a>
                        </div>
                    </div>
                {% endfor %}

                <div class="cr-dots" data-hero-carousel-target="dots">
                    {% for voiture in featuredVoitures %}
                        <button type="button" class="cr-dot {{ loop.first ? 'cr-active' }}" data-action="hero-carousel#goTo" data-hero-carousel-index-param="{{ loop.index0 }}" aria-label="Go to vehicle {{ loop.index }}"></button>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="cr-stage-fallback mx-auto mt-5">
                <i class="fas fa-car-side"></i>
            </div>
            <p class="text-muted mt-3">No vehicles are currently available. Please check back soon.</p>
        {% endif %}
    </div>
</section>

<section class="cr-section" id="brands">
    <div class="container">
        <div class="cr-section-title cr-reveal">
            <h2>Our Luxury Brands</h2>
            <div class="cr-underline"></div>
            <p>Browse our fleet by manufacturer</p>
        </div>
        {% if brands|length > 0 %}
            <div class="cr-brands-grid cr-reveal">
                {% for brand in brands %}
                    <a href="{{ path('app_catalog', {brand: brand}) }}" class="cr-brand">
                        <i class="fas fa-car"></i>
                        <span>{{ brand }}</span>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-center text-muted">No vehicle brands are in the catalog yet.</p>
        {% endif %}
    </div>
</section>

<section class="cr-section" style="background:var(--cr-black-soft);">
    <div class="container">
        <div class="cr-section-title cr-reveal">
            <h2>Featured Fleet</h2>
            <div class="cr-underline"></div>
            <p>A glimpse of what's available right now</p>
        </div>
        {% if featuredVoitures|length > 0 %}
            <div class="cr-grid">
                {% for voiture in featuredVoitures %}
                    {% include 'home/_car_card.html.twig' with {voiture: voiture} %}
                {% endfor %}
            </div>
            <div class="text-center mt-5 cr-reveal">
                <a href="{{ path('app_catalog') }}" class="btn-cr-outline">View Full Fleet <i class="fas fa-arrow-right ml-1"></i></a>
            </div>
        {% else %}
            <p class="text-center text-muted">No vehicles are currently available.</p>
        {% endif %}
    </div>
</section>
{% endblock %}
