{% extends 'base_public.html.twig' %}

{% block title %}New booking{% endblock %}

{% block body %}
{% include '_partials/page_header.html.twig' with {
    eyebrow: 'Reservation',
    title: 'Reserve',
    em: 'your car',
    lede: 'Choose the car and your dates. The total is calculated from your dates and confirmed when you save.',
    compact: true,
} %}

<section class="lx-section--tight">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="cr-panel cr-reveal cr-visible"><div class="cr-panel-body">
                    {% include 'reservation/_booking_form.html.twig' with {submit_label: 'Confirm booking', cancel_path: path('app_catalog')} %}
                </div></div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}{% include 'reservation/_price_preview.html.twig' %}{% endblock %}
