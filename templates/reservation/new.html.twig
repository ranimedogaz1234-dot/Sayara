{% extends 'base_public.html.twig' %}
{% block title %}New Booking{% endblock %}
{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4 cr-reveal cr-visible flex-wrap">
            <h1 class="h3 mb-0 font-weight-bold">New Booking</h1>
            <a href="{{ path('app_home') }}" class="btn-cr-outline"><i class="fas fa-arrow-left mr-1"></i>Back</a>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="cr-panel cr-panel-body cr-reveal cr-visible">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'reservationForm'}}) }}

                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="form-group">
                        <label style="color: var(--cr-gray-300);"><i class="fas fa-user mr-1"></i> Client</label>
                        {{ form_widget(form.client, {'attr': {'class': 'form-control cr-input'}}) }}
                        {{ form_errors(form.client) }}
                    </div>
                    {% endif %}

                    <div class="form-group">
                        <label style="color: var(--cr-gray-300);"><i class="fas fa-car mr-1"></i> Vehicle</label>
                        {{ form_widget(form.voiture, {'attr': {'class': 'form-control cr-input', 'id': 'voitureSelect'}}) }}
                        {{ form_errors(form.voiture) }}
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label style="color: var(--cr-gray-300);"><i class="fas fa-calendar-day mr-1"></i> Pick-up Date</label>
                                {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control cr-input', 'type': 'date', 'id': 'dateDebut'}}) }}
                                {{ form_errors(form.dateDebut) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label style="color: var(--cr-gray-300);"><i class="fas fa-calendar-day mr-1"></i> Return Date</label>
                                {{ form_widget(form.dateFin, {'attr': {'class': 'form-control cr-input', 'type': 'date', 'id': 'dateFin'}}) }}
                                {{ form_errors(form.dateFin) }}
                            </div>
                        </div>
                    </div>

                    <div id="pricePreview" class="alert alert-success d-none">
                        <i class="fas fa-calculator mr-2"></i>
                        <strong>Estimated price: <span id="estimatedPrice">0</span> DT</strong>
                        <small class="d-block mt-1" style="color: var(--cr-gray-300);">(<span id="numDays">0</span> days × <span id="pricePerDay">0</span> DT/day)</small>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('app_home') }}" class="btn-cr-outline">Cancel</a>
                        <button type="submit" class="btn-cr-primary">Confirm Booking</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
const voiturePrices = {};
document.querySelectorAll('#voitureSelect option').forEach(opt => {
    if (opt.value) {
        const match = opt.text.match(/\((\d+(?:\.\d+)?) DT\/jour\)/);
        if (match) voiturePrices[opt.value] = parseFloat(match[1]);
    }
});

function updatePrice() {
    const voitureId = document.getElementById('voitureSelect')?.value;
    const dateDebut = document.getElementById('dateDebut')?.value;
    const dateFin = document.getElementById('dateFin')?.value;
    const preview = document.getElementById('pricePreview');

    if (voitureId && dateDebut && dateFin && voiturePrices[voitureId]) {
        const d1 = new Date(dateDebut), d2 = new Date(dateFin);
        const days = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;
        if (days >= 1) {
            const price = days * voiturePrices[voitureId];
            document.getElementById('numDays').textContent = days;
            document.getElementById('pricePerDay').textContent = voiturePrices[voitureId];
            document.getElementById('estimatedPrice').textContent = price.toFixed(2);
            preview.classList.remove('d-none');
            return;
        }
    }
    preview.classList.add('d-none');
}

['voitureSelect', 'dateDebut', 'dateFin'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', updatePrice);
});
updatePrice();
</script>
{% endblock %}
