{% extends 'base_public.html.twig' %}

{% block title %}Edit booking #{{ '%04d'|format(reservation.id) }}{% endblock %}

{% block body %}
{% include '_partials/page_header.html.twig' with {
    eyebrow: 'Booking #' ~ '%04d'|format(reservation.id),
    title: 'Edit',
    em: 'booking',
    lede: 'The total is recalculated from the new dates and the car\'s daily rate.',
    compact: true,
} %}

<section class="lx-section--tight">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="cr-panel cr-reveal cr-visible"><div class="cr-panel-body">
                    {% include 'reservation/_booking_form.html.twig' with {submit_label: 'Save changes', cancel_path: path('app_reservation_show', {id: reservation.id})} %}
                </div></div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}{% include 'reservation/_price_preview.html.twig' %}{% endblock %}
