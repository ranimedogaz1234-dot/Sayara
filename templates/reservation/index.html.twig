{% extends 'base_public.html.twig' %}

{% block title %}{{ is_granted('ROLE_ADMIN') ? 'All reservations' : 'My bookings' }}{% endblock %}

{% block body %}
{% include '_partials/page_header.html.twig' with {
    eyebrow: is_granted('ROLE_ADMIN') ? 'Administration' : 'My account',
    title: is_granted('ROLE_ADMIN') ? 'All' : 'My',
    em: is_granted('ROLE_ADMIN') ? 'reservations' : 'bookings',
    lede: reservations|length ~ (reservations|length == 1 ? ' booking' : ' bookings') ~ (is_granted('ROLE_ADMIN') ? ' across all clients.' : ' on your account.'),
    compact: true,
} %}

<section class="lx-section--tight">
    <div class="container">
        <div class="d-flex justify-content-end mb-4">
            <a href="{{ path('app_reservation_new') }}" class="btn-lx btn-lx--gold btn-lx--sm">New booking</a>
        </div>
        <div class="cr-panel cr-reveal cr-visible">
            {% if reservations|length == 0 %}
                <div class="cr-panel-body text-center py-5">
                    <p class="title mb-4" style="font-size:1.8rem;">No bookings <em>yet</em></p>
                    <a href="{{ path('app_catalog') }}" class="btn-lx btn-lx--outline">Explore the fleet</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="cr-table cr-table--stack">
                        <thead>
                        <tr>
                            <th>Ref.</th>
                            {% if is_granted('ROLE_ADMIN') %}<th>Client</th>{% endif %}
                            <th>Car</th><th>Dates</th><th>Total</th><th>Status</th><th class="text-right">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for reservation in reservations %}
                            <tr>
                                <td data-label="Ref." class="meta" style="color:var(--gold);">#{{ '%04d'|format(reservation.id) }}</td>
                                {% if is_granted('ROLE_ADMIN') %}<td data-label="Client">{{ reservation.client.nom }}</td>{% endif %}
                                <td data-label="Car"><span style="font-family:var(--serif);font-size:18px;">{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</span></td>
                                <td data-label="Dates" style="white-space:nowrap;">{{ reservation.dateDebut|date('d M') }} — {{ reservation.dateFin|date('d M Y') }}</td>
                                <td data-label="Total" style="white-space:nowrap;">{{ reservation.prixTotal|usd }}</td>
                                <td data-label="Status">
                                    {% if reservation.statut == 'confirmed' %}
                                        <span class="cr-pill cr-pill-confirmed">Confirmed</span>
                                    {% else %}
                                        <span class="cr-pill cr-pill-pending">Awaiting payment</span>
                                    {% endif %}
                                </td>
                                <td class="text-right cr-table__actions" style="white-space:nowrap;">
                                    <a href="{{ path('app_reservation_show', {id: reservation.id}) }}" class="link-lx mr-3" style="padding-bottom:4px;">View</a>
                                    <a href="{{ path('app_reservation_edit', {id: reservation.id}) }}" class="link-lx mr-3" style="padding-bottom:4px;">Edit</a>
                                    <button type="button" class="link-lx" style="background:none;border-top:0;border-left:0;border-right:0;padding:0 0 4px;color:var(--warn);cursor:pointer;" data-toggle="modal" data-target="#deleteModal{{ reservation.id }}">Cancel</button>

                                    <div class="modal fade text-left" id="deleteModal{{ reservation.id }}" tabindex="-1" role="dialog" aria-labelledby="deleteTitle{{ reservation.id }}">
                                        <div class="modal-dialog modal-dialog-centered" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="deleteTitle{{ reservation.id }}">Cancel booking #{{ '%04d'|format(reservation.id) }}</h5>
                                                    <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
                                                </div>
                                                <div class="modal-body" style="white-space:normal;">
                                                    {{ reservation.voiture.marque }} {{ reservation.voiture.modele }}, {{ reservation.dateDebut|date('d M') }} — {{ reservation.dateFin|date('d M Y') }}{% if is_granted('ROLE_ADMIN') %}, for {{ reservation.client.nom }}{% endif %}. This cannot be undone.
                                                </div>
                                                <div class="modal-footer">
                                                    <button class="btn-lx btn-lx--outline btn-lx--sm" type="button" data-dismiss="modal">Keep it</button>
                                                    <form method="post" action="{{ path('app_reservation_delete', {id: reservation.id}) }}" style="display:inline">
                                                        <input type="hidden" name="_method" value="DELETE">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                                        <button class="btn-cr-danger btn-lx--sm" type="submit">Cancel booking</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
