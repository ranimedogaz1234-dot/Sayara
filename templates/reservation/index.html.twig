{% extends 'base.html.twig' %}

{% block title %}Liste des Réservations{% endblock %}

{% block body %}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-calendar-alt text-warning mr-2"></i>Liste des Réservations
    </h1>
    <a href="{{ path('app_reservation_new') }}" class="btn btn-warning shadow-sm">
        <i class="fas fa-plus-circle fa-sm mr-1"></i> Nouvelle Réservation
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-warning">
            <i class="fas fa-table mr-2"></i>Réservations Enregistrées
            <span class="badge badge-warning text-dark ml-2">{{ reservations|length }}</span>
        </h6>
    </div>
    <div class="card-body">
        {% if reservations|length == 0 %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-calendar-times fa-4x mb-3"></i>
                <p class="h5">Aucune réservation enregistrée.</p>
                <a href="{{ path('app_reservation_new') }}" class="btn btn-warning mt-2">
                    <i class="fas fa-plus mr-1"></i>Créer la première réservation
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%">
                    <thead class="thead-dark">
                    <tr>
                        <th width="60">#</th>
                        <th>Client</th>
                        <th>Voiture</th>
                        <th>Date Début</th>
                        <th>Date Fin</th>
                        <th>Prix Total</th>
                        <th>Statut</th>
                        <th width="220" class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td class="text-center font-weight-bold text-warning">{{ reservation.id }}</td>
                            <td>
                                <i class="fas fa-user text-muted mr-1"></i>
                                <strong>{{ reservation.client.nom }}</strong>
                            </td>
                            <td>
                                <i class="fas fa-car text-muted mr-1"></i>
                                {{ reservation.voiture.marque }} {{ reservation.voiture.modele }}
                            </td>
                            <td>
                                <span class="badge badge-light border">
                                    <i class="fas fa-calendar-day mr-1 text-success"></i>
                                    {{ reservation.dateDebut|date('d/m/Y') }}
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-light border">
                                    <i class="fas fa-calendar-day mr-1 text-danger"></i>
                                    {{ reservation.dateFin|date('d/m/Y') }}
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-warning text-dark px-3 py-2">
                                    <strong>{{ reservation.prixTotal }} DT</strong>
                                </span>
                            </td>
                            <td>
                                {% if reservation.statut == 'confirmed' %}
                                    <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Confirmée</span>
                                {% else %}
                                    <span class="badge badge-warning text-dark px-2 py-1"><i class="fas fa-clock mr-1"></i>En attente</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <a href="{{ path('app_reservation_show', {id: reservation.id}) }}"
                                   class="btn btn-info btn-sm mr-1" title="Consulter">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_reservation_edit', {id: reservation.id}) }}"
                                   class="btn btn-warning btn-sm mr-1" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm"
                                        title="Supprimer"
                                        data-toggle="modal" data-target="#deleteModal{{ reservation.id }}">
                                    <i class="fas fa-trash"></i>
                                </button>

                                <!-- Modal Suppression -->
                                <div class="modal fade" id="deleteModal{{ reservation.id }}" tabindex="-1" role="dialog">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title">
                                                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmer la suppression
                                                </h5>
                                                <button class="close text-white" type="button" data-dismiss="modal">
                                                    <span>&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                Supprimer la réservation #{{ reservation.id }} de
                                                <strong>{{ reservation.client.nom }}</strong> ?
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-secondary" type="button" data-dismiss="modal">
                                                    <i class="fas fa-times mr-1"></i>Annuler
                                                </button>
                                                <form method="post" action="{{ path('app_reservation_delete', {id: reservation.id}) }}" style="display:inline">
                                                    <input type="hidden" name="_method" value="DELETE">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                                    <button class="btn btn-danger" type="submit">
                                                        <i class="fas fa-trash mr-1"></i>Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}
