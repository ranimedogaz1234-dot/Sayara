{% extends 'base_public.html.twig' %}

{% block title %}My Bookings{% endblock %}

{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4 cr-reveal cr-visible flex-wrap">
            <h1 class="h3 mb-0 font-weight-bold">
                {{ is_granted('ROLE_ADMIN') ? 'All Reservations' : 'My Bookings' }}
            </h1>
            <a href="{{ path('app_reservation_new') }}" class="btn-cr-primary"><i class="fas fa-plus-circle mr-1"></i>New Booking</a>
        </div>

        <div class="cr-panel cr-reveal cr-visible">
            <div class="cr-panel-header">
                Reservations <span class="cr-pill cr-pill-pending ml-1">{{ reservations|length }}</span>
            </div>
            <div class="cr-panel-body">
                {% if reservations|length == 0 %}
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-calendar-times fa-3x mb-3 opacity-50"></i>
                        <p>No reservations yet.</p>
                        <a href="{{ path('app_reservation_new') }}" class="btn-cr-primary mt-2">Create your first booking</a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="cr-table table" width="100%">
                            <thead>
                            <tr>
                                <th>#</th>
                                {% if is_granted('ROLE_ADMIN') %}<th>Client</th>{% endif %}
                                <th>Vehicle</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for reservation in reservations %}
                                <tr>
                                    <td>{{ reservation.id }}</td>
                                    {% if is_granted('ROLE_ADMIN') %}<td>{{ reservation.client.nom }}</td>{% endif %}
                                    <td>{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</td>
                                    <td>{{ reservation.dateDebut|date('d/m/Y') }}</td>
                                    <td>{{ reservation.dateFin|date('d/m/Y') }}</td>
                                    <td>{{ reservation.prixTotal }} DT</td>
                                    <td>
                                        {% if reservation.statut == 'confirmed' %}
                                            <span class="cr-pill cr-pill-confirmed">Confirmed</span>
                                        {% else %}
                                            <span class="cr-pill cr-pill-pending">Pending</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-right">
                                        <a href="{{ path('app_reservation_show', {id: reservation.id}) }}" class="btn-cr-outline" style="padding:.3rem .7rem;font-size:.75rem;" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="{{ path('app_reservation_edit', {id: reservation.id}) }}" class="btn-cr-outline" style="padding:.3rem .7rem;font-size:.75rem;" title="Edit"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="btn-cr-danger" style="padding:.3rem .7rem;font-size:.75rem;" title="Delete" data-toggle="modal" data-target="#deleteModal{{ reservation.id }}"><i class="fas fa-trash"></i></button>

                                        <div class="modal fade" id="deleteModal{{ reservation.id }}" tabindex="-1" role="dialog">
                                            <div class="modal-dialog" role="document">
                                                <div class="modal-content" style="background: var(--cr-black-card); border: 1px solid var(--cr-border); color: #fff;">
                                                    <div class="modal-header" style="border-color: var(--cr-border);">
                                                        <h5 class="modal-title">Confirm deletion</h5>
                                                        <button class="close text-white" type="button" data-dismiss="modal"><span>&times;</span></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Delete reservation #{{ reservation.id }}
                                                        {% if is_granted('ROLE_ADMIN') %}for <strong>{{ reservation.client.nom }}</strong>{% endif %}?
                                                    </div>
                                                    <div class="modal-footer" style="border-color: var(--cr-border);">
                                                        <button class="btn-cr-outline" type="button" data-dismiss="modal">Cancel</button>
                                                        <form method="post" action="{{ path('app_reservation_delete', {id: reservation.id}) }}" style="display:inline">
                                                            <input type="hidden" name="_method" value="DELETE">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                                            <button class="btn-cr-danger" type="submit">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
