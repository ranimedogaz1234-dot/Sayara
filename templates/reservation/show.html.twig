{% extends 'base_public.html.twig' %}
{% block title %}Booking #{{ reservation.id }}{% endblock %}
{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4 cr-reveal cr-visible flex-wrap">
            <h1 class="h3 mb-0 font-weight-bold">Booking #{{ reservation.id }}</h1>
            <a href="{{ path('app_reservation_index') }}" class="btn-cr-outline"><i class="fas fa-arrow-left mr-1"></i>Back</a>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="cr-panel cr-panel-body cr-reveal cr-visible">
                    <table class="cr-table table">
                        <tr><th><i class="fas fa-user mr-2"></i>Client</th><td>{{ reservation.client.nom }}</td></tr>
                        <tr><th><i class="fas fa-car mr-2"></i>Vehicle</th><td>{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</td></tr>
                        <tr><th><i class="fas fa-calendar-day mr-2"></i>Pick-up</th><td>{{ reservation.dateDebut|date('d/m/Y') }}</td></tr>
                        <tr><th><i class="fas fa-calendar-day mr-2"></i>Return</th><td>{{ reservation.dateFin|date('d/m/Y') }}</td></tr>
                        <tr><th><i class="fas fa-money-bill-wave mr-2"></i>Total</th><td><strong>{{ reservation.prixTotal }} DT</strong></td></tr>
                        <tr>
                            <th><i class="fas fa-info-circle mr-2"></i>Status</th>
                            <td>
                                {% if reservation.statut == 'confirmed' %}
                                    <span class="cr-pill cr-pill-confirmed">Confirmed &amp; Paid</span>
                                {% else %}
                                    <span class="cr-pill cr-pill-pending">Pending Payment</span>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                    <hr style="border-color: var(--cr-border);">
                    <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap:.6rem;">
                        <a href="{{ path('app_reservation_index') }}" class="btn-cr-outline">Back</a>
                        <div class="d-flex flex-wrap" style="gap:.6rem;">
                            {% if not is_granted('ROLE_ADMIN') and reservation.statut != 'confirmed' %}
                                <a href="{{ path('app_payment_checkout', {id: reservation.id}) }}" class="btn-cr-primary">
                                    <i class="fas fa-credit-card mr-1"></i>Proceed to Payment
                                </a>
                            {% endif %}
                            <a href="{{ path('app_reservation_edit', {id: reservation.id}) }}" class="btn-cr-outline">Edit</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
