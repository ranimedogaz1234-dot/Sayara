{% extends 'base.html.twig' %}
{% block title %}Réservation #{{ reservation.id }}{% endblock %}
{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-calendar text-info mr-2"></i>Réservation #{{ reservation.id }}</h1>
    <div>
        <a href="{{ path('app_reservation_edit', {id: reservation.id}) }}" class="btn btn-warning mr-2"><i class="fas fa-edit mr-1"></i>Modifier</a>
        <a href="{{ path('app_reservation_index') }}" class="btn btn-secondary"><i class="fas fa-arrow-left mr-1"></i>Retour</a>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-warning text-dark">
                <h5 class="m-0 font-weight-bold"><i class="fas fa-calendar mr-2"></i>Réservation #{{ reservation.id }}</h5>
            </div>
            <div class="card-body p-4">
                <table class="table table-borderless">
                    <tr><th class="text-gray-600"><i class="fas fa-user mr-2 text-success"></i>Client</th><td><strong>{{ reservation.client.nom }}</strong></td></tr>
                    <tr><th class="text-gray-600"><i class="fas fa-car mr-2 text-primary"></i>Voiture</th><td>{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</td></tr>
                    <tr><th class="text-gray-600"><i class="fas fa-calendar-day mr-2 text-success"></i>Date Début</th><td>{{ reservation.dateDebut|date('d/m/Y') }}</td></tr>
                    <tr><th class="text-gray-600"><i class="fas fa-calendar-day mr-2 text-danger"></i>Date Fin</th><td>{{ reservation.dateFin|date('d/m/Y') }}</td></tr>
                    <tr><th class="text-gray-600"><i class="fas fa-money-bill-wave mr-2 text-warning"></i>Prix Total</th><td><span class="badge badge-warning text-dark px-3 py-2"><strong>{{ reservation.prixTotal }} DT</strong></span></td></tr>
                    <tr><th class="text-gray-600"><i class="fas fa-info-circle mr-2 text-info"></i>Statut</th>
                        <td>
                            {% if reservation.statut == 'confirmed' %}
                                <span class="badge badge-success px-3 py-2"><i class="fas fa-check-circle mr-1"></i>Confirmée &amp; Payée</span>
                            {% else %}
                                <span class="badge badge-warning text-dark px-3 py-2"><i class="fas fa-clock mr-1"></i>En attente de paiement</span>
                            {% endif %}
                        </td>
                    </tr>
                </table>
                <hr>
                <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap:8px;">
                    <a href="{{ path('app_reservation_index') }}" class="btn btn-secondary"><i class="fas fa-arrow-left mr-1"></i>Retour</a>
                    <div class="d-flex" style="gap:8px;">
                        {% if not is_granted('ROLE_ADMIN') and reservation.statut != 'confirmed' %}
                            <a href="{{ path('app_payment_checkout', {id: reservation.id}) }}" class="btn btn-success">
                                <i class="fas fa-credit-card mr-1"></i>Procéder au paiement
                            </a>
                        {% endif %}
                        <a href="{{ path('app_reservation_edit', {id: reservation.id}) }}" class="btn btn-warning"><i class="fas fa-edit mr-1"></i>Modifier</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
