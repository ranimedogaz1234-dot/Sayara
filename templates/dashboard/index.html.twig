{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord{% endblock %}

{% block stylesheets %}
<style>
.stat-card{border:none;border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.07);transition:transform .25s,box-shadow .25s;}
.stat-card:hover{transform:translateY(-4px);box-shadow:0 10px 30px rgba(0,0,0,.12);}
.circle-wrap{position:relative;display:inline-flex;align-items:center;justify-content:center;}
.circle-wrap svg{transform:rotate(-90deg);}
.circle-wrap .circle-text{position:absolute;text-align:center;}
.circle-wrap .circle-pct{font-size:1.1rem;font-weight:800;color:#2e3338;line-height:1;}
.circle-wrap .circle-sub{font-size:.6rem;color:#858796;}
.chart-card{border:none;border-radius:14px;box-shadow:0 4px 20px rgba(0,0,0,.07);overflow:hidden;}
.chart-card .chart-header{padding:16px 22px;font-weight:700;font-size:.92rem;border-bottom:1px solid #f1f3f9;display:flex;align-items:center;gap:8px;}
.trend-up{color:#1cc88a;font-size:.75rem;font-weight:700;}
.avail-bar{height:8px;border-radius:4px;background:#e3e6f0;overflow:hidden;}
.avail-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,#2a33a3,#1cc88a);transition:width 1s ease;}
.status-badge{padding:3px 10px;border-radius:20px;font-size:.7rem;font-weight:700;}
.status-confirmed{background:#d4edda;color:#155724;}
.status-pending{background:#fff3cd;color:#856404;}
</style>
{% endblock %}

{% block body %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-tachometer-alt text-primary mr-2"></i>Tableau de Bord</h1>
    <span class="text-muted small"><i class="fas fa-calendar-alt mr-1"></i>{{ "now"|date("d/m/Y") }}</span>
</div>

<!-- KPI CARDS -->
<div class="row mb-4">
    <!-- Voitures -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100" style="border-top:4px solid #2a33a3;">
            <div class="card-body d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-xs font-weight-bold text-uppercase mb-1" style="color:#2a33a3;">Total Voitures</div>
                    <div class="h2 mb-0 font-weight-bold text-gray-800">{{ nb_voitures }}</div>
                    <div class="avail-bar mt-2"><div class="avail-fill" style="width:{{ nb_voitures > 0 ? ((nb_voitures_dispo / nb_voitures) * 100)|round : 0 }}%;"></div></div>
                    <div class="text-xs text-muted mt-1">{{ nb_voitures_dispo }} disponibles</div>
                </div>
                <div class="ml-3">
                    {% set pct = nb_voitures > 0 ? ((nb_voitures_dispo / nb_voitures) * 100)|round : 0 %}
                    {% set circ = 175.93 %}
                    {% set dash = (pct / 100) * circ %}
                    <div class="circle-wrap" style="width:72px;height:72px;">
                        <svg width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="28" fill="none" stroke="#e3e6f0" stroke-width="7"/><circle cx="36" cy="36" r="28" fill="none" stroke="#2a33a3" stroke-width="7" stroke-dasharray="{{ dash }} {{ circ }}" stroke-linecap="round"/></svg>
                        <div class="circle-text"><div class="circle-pct">{{ pct }}%</div><div class="circle-sub">dispo</div></div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                <a href="{{ path('app_voiture_index') }}" class="btn btn-sm btn-primary"><i class="fas fa-list mr-1"></i>Voir les voitures</a>
            </div>
        </div>
    </div>
    <!-- Clients -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100" style="border-top:4px solid #1cc88a;">
            <div class="card-body d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Clients</div>
                    <div class="h2 mb-0 font-weight-bold text-gray-800">{{ nb_clients }}</div>
                    <div class="mt-2"><span class="badge badge-success"><i class="fas fa-user mr-1"></i>Enregistrés</span></div>
                </div>
                <div class="ml-3">
                    {% set cpct = min(nb_clients, 50) %}
                    {% set cdash = (cpct / 50) * 175.93 %}
                    <div class="circle-wrap" style="width:72px;height:72px;">
                        <svg width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="28" fill="none" stroke="#e3e6f0" stroke-width="7"/><circle cx="36" cy="36" r="28" fill="none" stroke="#1cc88a" stroke-width="7" stroke-dasharray="{{ cdash }} 175.93" stroke-linecap="round"/></svg>
                        <div class="circle-text"><div class="circle-pct" style="font-size:1rem;">{{ nb_clients }}</div><div class="circle-sub">clients</div></div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-success"><i class="fas fa-list mr-1"></i>Voir les clients</a>
            </div>
        </div>
    </div>
    <!-- Réservations -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100" style="border-top:4px solid #f6c23e;">
            <div class="card-body d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total Réservations</div>
                    <div class="h2 mb-0 font-weight-bold text-gray-800">{{ nb_reservations }}</div>
                    <div class="mt-2"><span class="badge badge-warning text-dark"><i class="fas fa-calendar-check mr-1"></i>Locations</span></div>
                </div>
                <div class="ml-3">
                    {% set rpct = nb_voitures > 0 ? (((nb_voitures - nb_voitures_dispo) / nb_voitures) * 100)|round : 0 %}
                    {% set rdash = (rpct / 100) * 175.93 %}
                    <div class="circle-wrap" style="width:72px;height:72px;">
                        <svg width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="28" fill="none" stroke="#e3e6f0" stroke-width="7"/><circle cx="36" cy="36" r="28" fill="none" stroke="#f6c23e" stroke-width="7" stroke-dasharray="{{ rdash }} 175.93" stroke-linecap="round"/></svg>
                        <div class="circle-text"><div class="circle-pct">{{ rpct }}%</div><div class="circle-sub">occupé</div></div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                <a href="{{ path('app_reservation_index') }}" class="btn btn-sm btn-warning"><i class="fas fa-list mr-1"></i>Voir les réservations</a>
            </div>
        </div>
    </div>
    <!-- Revenus -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100" style="border-top:4px solid #e74a3b;">
            <div class="card-body d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Revenus Totaux</div>
                    <div class="h4 mb-0 font-weight-bold text-gray-800">{{ total_revenus|usd }}</div>
                    <div class="mt-2"><span class="trend-up"><i class="fas fa-arrow-up mr-1"></i>Tous temps</span></div>
                </div>
                <div class="ml-3">
                    <div class="circle-wrap" style="width:72px;height:72px;">
                        <svg width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="28" fill="none" stroke="#e3e6f0" stroke-width="7"/><circle cx="36" cy="36" r="28" fill="none" stroke="#e74a3b" stroke-width="7" stroke-dasharray="123.15 175.93" stroke-linecap="round"/></svg>
                        <div class="circle-text"><i class="fas fa-coins text-danger" style="font-size:1.2rem;"></i></div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                <span class="text-xs text-muted"><i class="fas fa-info-circle mr-1"></i>Cumul de toutes réservations</span>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row mb-4">
    <div class="col-lg-8 mb-4">
        <div class="card chart-card shadow h-100">
            <div class="chart-header" style="background:linear-gradient(135deg,#2a33a3,#1a237e);">
                <i class="fas fa-chart-bar text-white"></i><span class="text-white">Répartition du parc automobile</span>
            </div>
            <div class="card-body"><canvas id="fleetChart" style="max-height:250px;"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4 mb-4">
        <div class="card chart-card shadow h-100">
            <div class="chart-header" style="background:linear-gradient(135deg,#1cc88a,#17a673);">
                <i class="fas fa-chart-pie text-white"></i><span class="text-white">Disponibilité du parc</span>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <canvas id="availChart" style="max-width:200px;max-height:200px;"></canvas>
                <div class="d-flex mt-3" style="gap:16px;">
                    <span style="font-size:.8rem;"><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#2a33a3;margin-right:4px;"></span>Disponibles ({{ nb_voitures_dispo }})</span>
                    <span style="font-size:.8rem;"><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#e74a3b;margin-right:4px;"></span>Louées ({{ nb_voitures - nb_voitures_dispo }})</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ACCÈS RAPIDES -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-bolt mr-2"></i>Accès Rapides</h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4 mb-3">
                        <a href="{{ path('app_voiture_new') }}" class="btn btn-outline-primary btn-block py-3">
                            <i class="fas fa-plus-circle fa-2x d-block mb-2"></i><strong>Ajouter une Voiture</strong>
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a href="{{ path('app_user_new') }}" class="btn btn-outline-success btn-block py-3">
                            <i class="fas fa-user-plus fa-2x d-block mb-2"></i><strong>Ajouter un Client</strong>
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a href="{{ path('app_reservation_new') }}" class="btn btn-outline-warning btn-block py-3">
                            <i class="fas fa-calendar-plus fa-2x d-block mb-2"></i><strong>Nouvelle Réservation</strong>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DERNIÈRES RÉSERVATIONS -->
{% if dernieres_reservations is defined and dernieres_reservations|length > 0 %}
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-warning"><i class="fas fa-history mr-2"></i>Dernières Réservations</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                        <tr><th>#</th><th>Client</th><th>Voiture</th><th>Date Début</th><th>Date Fin</th><th>Prix Total</th><th>Statut</th></tr>
                        </thead>
                        <tbody>
                        {% for r in dernieres_reservations %}
                            <tr>
                                <td>{{ r.id }}</td>
                                <td>{{ r.client.nom }}</td>
                                <td>{{ r.voiture.marque }} {{ r.voiture.modele }}</td>
                                <td>{{ r.dateDebut|date('d/m/Y') }}</td>
                                <td>{{ r.dateFin|date('d/m/Y') }}</td>
                                <td><strong>{{ r.prixTotal|usd(2) }}</strong></td>
                                <td>
                                    {% if r.statut == 'confirmed' %}
                                        <span class="status-badge status-confirmed"><i class="fas fa-check-circle mr-1"></i>Confirmée</span>
                                    {% else %}
                                        <span class="status-badge status-pending"><i class="fas fa-clock mr-1"></i>En attente</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script>
const fleetData = {{ fleet_chart_data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
new Chart(document.getElementById('fleetChart'), {
    type: 'bar',
    data: {
        labels: fleetData.labels,
        datasets: [
            { label: 'Disponibles', data: fleetData.available, backgroundColor: 'rgba(42,51,163,0.75)', borderColor: '#2a33a3', borderWidth: 2, borderRadius: 6 },
            { label: 'Louées',      data: fleetData.rented,    backgroundColor: 'rgba(231,74,59,0.7)',  borderColor: '#e74a3b', borderWidth: 2, borderRadius: 6 }
        ]
    },
    options: { responsive:true, maintainAspectRatio:true, plugins:{legend:{position:'top'}}, scales:{x:{stacked:true,grid:{display:false}},y:{stacked:true,beginAtZero:true,ticks:{stepSize:1}}} }
});
new Chart(document.getElementById('availChart'), {
    type: 'doughnut',
    data: { labels:['Disponibles','Louées'], datasets:[{data:[{{ nb_voitures_dispo }},{{ nb_voitures - nb_voitures_dispo }}],backgroundColor:['#2a33a3','#e74a3b'],borderWidth:0,hoverOffset:8}] },
    options: { responsive:true, cutout:'70%', plugins:{legend:{display:false}} }
});
</script>
{% endblock %}
