{% extends 'base_public.html.twig' %}

{% block title %}My account{% endblock %}

{% block body %}
{% include '_partials/page_header.html.twig' with {
    eyebrow: 'My account',
    title: 'Welcome,',
    em: app.user.nom,
    lede: 'Your details and every booking you have made, in one place.',
    compact: true,
} %}

<section class="lx-section--tight">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-5 mb-lg-0">
                <div class="cr-panel cr-reveal cr-visible">
                    <div class="cr-panel-header">Profile</div>
                    <div class="cr-panel-body">
                        <dl class="lx-specs mt-0 mb-4">
                            <div><dt>Name</dt><dd>{{ app.user.nom }}</dd></div>
                            <div><dt>Username</dt><dd>{{ app.user.username }}</dd></div>
                            <div><dt>Email</dt><dd style="font-family:var(--sans);font-size:14px;word-break:break-all;">{{ app.user.email }}</dd></div>
                        </dl>
                        <a href="{{ path('app_profile_edit') }}" class="btn-lx btn-lx--outline btn-lx--block mb-3">Edit profile</a>
                        <a href="#" data-toggle="modal" data-target="#crLogoutModal" class="btn-cr-danger btn-lx--block">Sign out</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="cr-panel cr-reveal cr-visible">
                    <div class="cr-panel-header d-flex align-items-center justify-content-between">
                        <span>My bookings &middot; {{ '%02d'|format(reservations|length) }}</span>
                        <a href="{{ path('app_catalog') }}" class="link-lx" style="padding-bottom:4px;">Book a car <span class="arrow">&rarr;</span></a>
                    </div>
                    {% if reservations|length == 0 %}
                        <div class="cr-panel-body text-center py-5">
                            <p class="title mb-4" style="font-size:1.8rem;">No bookings <em>yet</em></p>
                            <a href="{{ path('app_catalog') }}" class="btn-lx btn-lx--gold">Explore the fleet</a>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="cr-table cr-table--stack">
                                <thead><tr><th>Ref.</th><th>Car</th><th>Dates</th><th>Total</th><th></th></tr></thead>
                                <tbody>
                                {% for reservation in reservations %}
                                    <tr>
                                        <td data-label="Ref." class="meta" style="color:var(--gold);">#{{ '%04d'|format(reservation.id) }}</td>
                                        <td data-label="Car"><span style="font-family:var(--serif);font-size:18px;">{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</span></td>
                                        <td data-label="Dates" style="white-space:nowrap;">{{ reservation.dateDebut|date('d M') }} — {{ reservation.dateFin|date('d M Y') }}</td>
                                        <td data-label="Total" style="white-space:nowrap;">{{ reservation.prixTotal|number_format(0, '.', ' ') }} DT</td>
                                        <td class="text-right cr-table__actions"><a href="{{ path('app_reservation_show', {id: reservation.id}) }}" class="link-lx" style="padding-bottom:4px;">View <span class="arrow">&rarr;</span></a></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
