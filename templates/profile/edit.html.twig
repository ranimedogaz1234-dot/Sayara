{% extends 'base_public.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
<section class="cr-section pt-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4 cr-reveal cr-visible flex-wrap">
            <h1 class="h3 mb-0 font-weight-bold">Edit Profile</h1>
            <a href="{{ path('app_profile') }}" class="btn-cr-outline"><i class="fas fa-arrow-left mr-1"></i>Back</a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="cr-panel cr-panel-body cr-reveal cr-visible">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="form-group">
                        <label style="color: var(--cr-gray-300);">Username</label>
                        {{ form_widget(form.username, {'attr': {'class': 'form-control cr-input'}}) }}
                        {{ form_errors(form.username) }}
                    </div>
                    <div class="form-group">
                        <label style="color: var(--cr-gray-300);">Full Name</label>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control cr-input'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="form-group">
                        <label style="color: var(--cr-gray-300);">Email</label>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control cr-input'}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="form-group">
                        <label style="color: var(--cr-gray-300);">Password</label>
                        {{ form_widget(form.password, {'attr': {'class': 'form-control cr-input', 'placeholder': 'Leave blank to keep your current password'}}) }}
                        {{ form_errors(form.password) }}
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('app_profile') }}" class="btn-cr-outline">Cancel</a>
                        <button type="submit" class="btn-cr-primary">Save Changes</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
