{% extends 'base_public.html.twig' %}

{% block title %}Edit profile{% endblock %}

{% block body %}
{% include '_partials/page_header.html.twig' with {
    eyebrow: 'My account',
    title: 'Edit',
    em: 'profile',
    lede: 'Leave the password empty to keep your current one.',
    compact: true,
} %}

<section class="lx-section--tight">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="cr-panel cr-reveal cr-visible">
                    <div class="cr-panel-body">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="form-group lx-field">
                                {{ form_label(form.username, 'Username') }}
                                {{ form_widget(form.username, {'attr': {'class': 'lx-input'}}) }}
                                {{ form_errors(form.username) }}
                            </div>
                            <div class="form-group lx-field">
                                {{ form_label(form.nom, 'Full name') }}
                                {{ form_widget(form.nom, {'attr': {'class': 'lx-input'}}) }}
                                {{ form_errors(form.nom) }}
                            </div>
                            <div class="form-group lx-field">
                                {{ form_label(form.email, 'Email') }}
                                {{ form_widget(form.email, {'attr': {'class': 'lx-input'}}) }}
                                {{ form_errors(form.email) }}
                            </div>
                            <div class="form-group lx-field">
                                {{ form_label(form.password, 'New password') }}
                                {{ form_widget(form.password, {'attr': {'class': 'lx-input', 'placeholder': 'Leave blank to keep your current password', 'autocomplete': 'new-password'}}) }}
                                {{ form_errors(form.password) }}
                            </div>
                            <div class="d-flex justify-content-between flex-wrap mt-4" style="gap:12px;">
                                <a href="{{ path('app_profile') }}" class="btn-lx btn-lx--outline">Cancel</a>
                                <button type="submit" class="btn-lx btn-lx--gold">Save changes</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
