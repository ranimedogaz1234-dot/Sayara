{% extends 'base.html.twig' %}

{% block title %}Voiture — {{ voiture.marque }} {{ voiture.modele }}{% endblock %}

{% block body %}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-eye text-info mr-2"></i>Détails de la Voiture
    </h1>
    <div>
        <a href="{{ path('app_voiture_edit', {id: voiture.id}) }}" class="btn btn-warning shadow-sm mr-2">
            <i class="fas fa-edit mr-1"></i>Modifier
        </a>
        <a href="{{ path('app_voiture_index') }}" class="btn btn-secondary shadow-sm">
            <i class="fas fa-arrow-left mr-1"></i>Retour
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-info text-white">
                <h5 class="m-0 font-weight-bold">
                    <i class="fas fa-car mr-2"></i>{{ voiture.marque }} {{ voiture.modele }}
                </h5>
            </div>
            {% if voiture.image %}
            <div class="text-center py-3" style="background-color: #f8f9fa;">
                <img src="{{ asset('uploads/voitures/' ~ voiture.image) }}" alt="{{ voiture.marque }} {{ voiture.modele }}" style="max-height: 300px; border-radius: 0.5rem;">
            </div>
            {% endif %}
            <div class="card-body p-4">
                <table class="table table-borderless">
                    <tr>
                        <th width="40%" class="text-gray-600"><i class="fas fa-hashtag mr-2 text-primary"></i>ID</th>
                        <td><strong>#{{ voiture.id }}</strong></td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-tag mr-2 text-primary"></i>Marque</th>
                        <td>{{ voiture.marque }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-car-side mr-2 text-primary"></i>Modèle</th>
                        <td>{{ voiture.modele }}</td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-money-bill-wave mr-2 text-success"></i>Prix / Jour</th>
                        <td><span class="badge badge-info px-3 py-2">{{ voiture.prixParJour|usd }}</span></td>
                    </tr>
                    <tr>
                        <th class="text-gray-600"><i class="fas fa-circle mr-2"></i>Disponibilité</th>
                        <td>
                            {% if voiture.disponible %}
                                <span class="badge badge-success px-3 py-2"><i class="fas fa-check-circle mr-1"></i>Disponible</span>
                            {% else %}
                                <span class="badge badge-danger px-3 py-2"><i class="fas fa-times-circle mr-1"></i>Indisponible</span>
                            {% endif %}
                        </td>
                    </tr>
                </table>

                <hr>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_voiture_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i>Retour à la liste
                    </a>
                    <div>
                        <a href="{{ path('app_voiture_edit', {id: voiture.id}) }}" class="btn btn-warning mr-2">
                            <i class="fas fa-edit mr-1"></i>Modifier
                        </a>
                        <form method="post" action="{{ path('app_voiture_delete', {id: voiture.id}) }}" style="display:inline">
                            <input type="hidden" name="_method" value="DELETE">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
                            <button class="btn btn-danger" type="submit"
                                    onclick="return confirm('Confirmer la suppression ?')">
                                <i class="fas fa-trash mr-1"></i>Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
