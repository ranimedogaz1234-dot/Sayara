{% extends 'base_public.html.twig' %}
{% block title %}Booking Confirmed #{{ reservation.id }}{% endblock %}

{% block stylesheets %}
<style>
.confirmation-hero { text-align:center; padding:3rem 2rem 2rem; }
.confirmation-hero .check-circle { width:84px;height:84px;border-radius:50%;border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;box-shadow:0 0 60px rgba(197,164,109,.18); }
.confirmation-hero .check-circle i { font-size:1.8rem;color:var(--gold); }
.detail-row { display:flex;justify-content:space-between;align-items:baseline;padding:.8rem 0;border-bottom:1px solid var(--line); }
.detail-row:last-child { border-bottom:none; }
.detail-label { font:500 9.5px/1.6 var(--sans);letter-spacing:.26em;text-transform:uppercase;color:var(--grey); }
.detail-value { font-family:var(--serif);font-size:17px;color:var(--ivory); }
.ref-badge { display:inline-block;border:1px solid var(--gold-line);color:var(--gold);padding:.6rem 1.5rem;font:500 12px/1 var(--sans);letter-spacing:.3em; }
.payment-stepper{display:flex;align-items:center;justify-content:center;margin-bottom:2rem;gap:0;}
.step{display:flex;flex-direction:column;align-items:center;position:relative;}
.step-circle{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);background:var(--ink);color:var(--grey);}
.step-circle i{font-size:11px;}
.step.done .step-circle{border-color:var(--gold-line);color:var(--gold);}
.step-label{margin-top:10px;font:500 9.5px/1 var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--grey-dim);white-space:nowrap;}
.step.done .step-label{color:var(--gold);}
.step-connector{flex:1;height:1px;background:var(--line);min-width:32px;max-width:80px;margin-bottom:20px;}
.step-connector.done{background:var(--gold-line);}
</style>
{% endblock %}

{% block body %}
<section class="lx-section--tight" style="padding-top: calc(var(--nav-h) + 64px);">
<div class="container">
<div class="payment-stepper mb-2 cr-reveal cr-visible">
    <div class="step done"><div class="step-circle"><i class="fas fa-check"></i></div><div class="step-label">Vehicle</div></div>
    <div class="step-connector done"></div>
    <div class="step done"><div class="step-circle"><i class="fas fa-check"></i></div><div class="step-label">Booking</div></div>
    <div class="step-connector done"></div>
    <div class="step done"><div class="step-circle"><i class="fas fa-check"></i></div><div class="step-label">Payment</div></div>
    <div class="step-connector done"></div>
    <div class="step done"><div class="step-circle"><i class="fas fa-check"></i></div><div class="step-label">Confirmation</div></div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="cr-panel mb-4 cr-reveal cr-visible">
            <div class="confirmation-hero">
                <div class="check-circle"><i class="fas fa-check"></i></div>
                <span class="eyebrow">Booking confirmed</span><h2 class="display mt-3 mb-3" style="font-size:2.6rem;">Thank you, <em>enjoy the drive</em></h2>
                <p class="mb-3" style="color: var(--cr-gray-300);">Your payment was processed and your booking is confirmed.</p>
                <div class="ref-badge mb-3">Ref. #{{ '%05d'|format(reservation.id) }}</div>
                <p class="small" style="color: var(--cr-gray-300);">
                    <i class="fas fa-envelope mr-1" style="color: var(--gold);"></i>
                    A confirmation email has been sent to <strong>{{ app.user.email }}</strong>
                </p>
            </div>
        </div>

        <div class="cr-panel mb-4 cr-reveal cr-visible">
            <div class="cr-panel-header"><i class="fas fa-clipboard-list mr-2"></i>Booking Details</div>
            <div class="cr-panel-body">
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-car mr-2"></i>Vehicle</span>
                    <span class="detail-value">{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-user mr-2"></i>Client</span>
                    <span class="detail-value">{{ reservation.client.nom }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-calendar-day mr-2"></i>Pick-up date</span>
                    <span class="detail-value">{{ reservation.dateDebut|date('d/m/Y') }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-calendar-day mr-2"></i>Return date</span>
                    <span class="detail-value">{{ reservation.dateFin|date('d/m/Y') }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-sun mr-2"></i>Duration</span>
                    <span class="detail-value">
                        {% set days = (reservation.dateFin.timestamp - reservation.dateDebut.timestamp) / 86400 + 1 %}
                        {{ days|round(0,'ceil') }} day(s)
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-tag mr-2"></i>Price/day</span>
                    <span class="detail-value">{{ reservation.voiture.prixParJour|usd }}</span>
                </div>
                <div class="detail-row" style="background:rgba(255,255,255,.03);border-radius:6px;padding:.75rem .5rem;">
                    <span class="detail-label" style="color:var(--gold);">Total paid</span>
                    <span class="detail-value" style="font-size:1.3rem;">{{ reservation.prixTotal|usd(2) }}</span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between flex-wrap cr-reveal cr-visible" style="gap:.6rem;">
            <a href="{{ path('app_home') }}" class="btn-cr-outline"><i class="fas fa-home mr-1"></i>Back to home</a>
            <a href="{{ path('app_profile') }}" class="btn-cr-primary"><i class="fas fa-list mr-1"></i>My bookings</a>
        </div>
    </div>
</div>
</div>
</section>
{% endblock %}
