{% extends 'base_public.html.twig' %}
{% block title %}Payment — Booking #{{ reservation.id }}{% endblock %}

{% block stylesheets %}
<style>
.payment-stepper { display:flex; align-items:center; justify-content:center; margin-bottom:2rem; gap:0; }
.step { display:flex; flex-direction:column; align-items:center; position:relative; }
.step-circle { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:.9rem; border:2px solid var(--cr-border); background:var(--cr-black-card); color:var(--cr-gray-300); z-index:1; }
.step.done   .step-circle { background:var(--cr-success); border-color:var(--cr-success); color:#fff; }
.step.active .step-circle { background:#fff; border-color:#fff; color:#000; }
.step-label { font-size:.7rem; font-weight:600; margin-top:4px; color:var(--cr-gray-500); white-space:nowrap; }
.step.active .step-label { color:#fff; }
.step.done   .step-label { color:var(--cr-success); }
.step-connector { flex:1; height:2px; background:var(--cr-border); min-width:40px; max-width:80px; margin-bottom:18px; }
.step-connector.done { background:var(--cr-success); }

.payment-card { background:var(--cr-black-card); border:1px solid var(--cr-border); border-radius:var(--cr-radius); }
.payment-card .form-control { background:#0f0f0f; border:1px solid var(--cr-border); color:#fff; }
.payment-card .form-control:focus { background:#0f0f0f; color:#fff; border-color:var(--cr-gray-300); box-shadow:0 0 0 .2rem rgba(255,255,255,.08); }
.payment-card label { color: var(--cr-gray-300); }
.card-input-group { position:relative; }
.card-input-group .card-icons { position:absolute; right:12px; top:50%; transform:translateY(-50%); display:flex; gap:4px; opacity:.5; color:#fff; }
.card-input-group input { padding-right:90px; }

.payment-summary { background:linear-gradient(135deg,#1a1a1a,#0a0a0a); border:1px solid var(--cr-border); color:#fff; border-radius:var(--cr-radius); padding:1.5rem; }
.payment-summary .price-total { font-size:2rem; font-weight:800; }

.security-badges { display:flex; gap:12px; flex-wrap:wrap; }
.security-badge { display:flex; align-items:center; gap:6px; font-size:.72rem; color: var(--cr-gray-300); }
.security-badge i { color: var(--cr-success); }

.is-invalid ~ .invalid-feedback { display:block; }
</style>
{% endblock %}

{% block body %}
<section class="cr-section pt-5">
<div class="container">
<div class="d-sm-flex align-items-center justify-content-between mb-4 cr-reveal cr-visible">
    <h1 class="h3 mb-0 font-weight-bold">
        <i class="fas fa-credit-card mr-2"></i>Secure Payment
    </h1>
    <a href="{{ path('app_reservation_index') }}" class="btn-cr-outline">
        <i class="fas fa-arrow-left fa-sm mr-1"></i>Back
    </a>
</div>

<div class="payment-stepper mb-4 cr-reveal cr-visible">
    <div class="step done"><div class="step-circle"><i class="fas fa-check"></i></div><div class="step-label">Vehicle</div></div>
    <div class="step-connector done"></div>
    <div class="step done"><div class="step-circle"><i class="fas fa-check"></i></div><div class="step-label">Booking</div></div>
    <div class="step-connector done"></div>
    <div class="step active"><div class="step-circle">3</div><div class="step-label">Payment</div></div>
    <div class="step-connector"></div>
    <div class="step"><div class="step-circle">4</div><div class="step-label">Confirmation</div></div>
</div>

<div class="row">
    <div class="col-lg-7 mb-4 cr-reveal cr-visible">
        <div class="payment-card">
            <div class="cr-panel-header"><i class="fas fa-lock mr-2"></i>Secure payment details</div>
            <div class="p-4">
                <div class="alert alert-warning" role="alert">
                    <strong>Demo mode:</strong> no real payment is processed and card data is never stored or sent to any provider. Do not enter a real card number.
                </div>
                <form method="POST" action="{{ path('app_payment_checkout', {id: reservation.id}) }}" id="paymentForm" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('payment_' ~ reservation.id) }}">

                    <div class="form-group">
                        <label class="font-weight-bold"><i class="fas fa-credit-card mr-1"></i>Card number</label>
                        <div class="card-input-group">
                            <input type="text" name="card_number" id="cardNumber"
                                   class="form-control form-control-lg {{ errors.card_number is defined ? 'is-invalid' : '' }}"
                                   placeholder="1234 5678 9012 3456" maxlength="23"
                                   value="{{ app.request.request.get('card_number', '') }}" autocomplete="cc-number">
                            <div class="card-icons">
                                <i class="fab fa-cc-visa fa-lg"></i>
                                <i class="fab fa-cc-mastercard fa-lg"></i>
                            </div>
                            {% if errors.card_number is defined %}
                                <div class="invalid-feedback">{{ errors.card_number }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold"><i class="fas fa-user mr-1"></i>Cardholder name</label>
                        <input type="text" name="card_holder" id="cardHolder"
                               class="form-control {{ errors.card_holder is defined ? 'is-invalid' : '' }}"
                               placeholder="FIRST LAST" style="text-transform:uppercase;"
                               value="{{ app.request.request.get('card_holder', app.user.nom|upper) }}" autocomplete="cc-name">
                        {% if errors.card_holder is defined %}
                            <div class="invalid-feedback">{{ errors.card_holder }}</div>
                        {% endif %}
                    </div>

                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label class="font-weight-bold"><i class="fas fa-calendar-alt mr-1"></i>Expiry date</label>
                                <div class="row">
                                    <div class="col-6">
                                        <select name="expiry_month" class="form-control {{ errors.expiry is defined ? 'is-invalid' : '' }}">
                                            <option value="">Month</option>
                                            {% for m in months %}
                                                <option value="{{ '%02d'|format(m) }}" {{ app.request.request.get('expiry_month') == '%02d'|format(m) ? 'selected' : '' }}>
                                                    {{ '%02d'|format(m) }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <select name="expiry_year" class="form-control {{ errors.expiry is defined ? 'is-invalid' : '' }}">
                                            <option value="">Year</option>
                                            {% for y in years %}
                                                <option value="{{ y }}" {{ app.request.request.get('expiry_year') == y ? 'selected' : '' }}>{{ y }}</option>
                                            {% endfor %}
                                        </select>
                                        {% if errors.expiry is defined %}
                                            <div class="invalid-feedback d-block">{{ errors.expiry }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="font-weight-bold"><i class="fas fa-lock mr-1"></i>CVV</label>
                                <input type="password" name="cvv" id="cvv"
                                       class="form-control {{ errors.cvv is defined ? 'is-invalid' : '' }}"
                                       placeholder="•••" maxlength="4" autocomplete="cc-csc">
                                {% if errors.cvv is defined %}
                                    <div class="invalid-feedback">{{ errors.cvv }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: var(--cr-border);" class="my-4">
                    <h6 class="font-weight-bold mb-3"><i class="fas fa-map-marker-alt mr-1"></i>Billing address</h6>

                    <div class="form-group">
                        <label class="font-weight-bold">Address</label>
                        <input type="text" name="billing_address"
                               class="form-control {{ errors.billing_address is defined ? 'is-invalid' : '' }}"
                               placeholder="12 Main Street"
                               value="{{ app.request.request.get('billing_address', '') }}" autocomplete="street-address">
                        {% if errors.billing_address is defined %}
                            <div class="invalid-feedback">{{ errors.billing_address }}</div>
                        {% endif %}
                    </div>

                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label class="font-weight-bold">City</label>
                                <input type="text" name="billing_city"
                                       class="form-control {{ errors.billing_city is defined ? 'is-invalid' : '' }}"
                                       placeholder="City"
                                       value="{{ app.request.request.get('billing_city', '') }}" autocomplete="address-level2">
                                {% if errors.billing_city is defined %}
                                    <div class="invalid-feedback">{{ errors.billing_city }}</div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="font-weight-bold">Postal code</label>
                                <input type="text" name="billing_zip"
                                       class="form-control {{ errors.billing_zip is defined ? 'is-invalid' : '' }}"
                                       placeholder="1000"
                                       value="{{ app.request.request.get('billing_zip', '') }}" autocomplete="postal-code">
                                {% if errors.billing_zip is defined %}
                                    <div class="invalid-feedback">{{ errors.billing_zip }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: var(--cr-border);" class="my-4">

                    <div class="security-badges mb-4">
                        <div class="security-badge"><i class="fas fa-shield-alt"></i> SSL 256-bit</div>
                        <div class="security-badge"><i class="fas fa-lock"></i> Secure payment</div>
                        <div class="security-badge"><i class="fas fa-check-circle"></i> Data protected</div>
                        <div class="security-badge"><i class="fas fa-undo"></i> No real transaction</div>
                    </div>

                    <button type="submit" class="btn-cr-primary w-100">
                        <i class="fas fa-lock mr-2"></i>Confirm Payment — {{ reservation.prixTotal|number_format(2, ',', ' ') }} DT
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5 cr-reveal cr-visible">
        <div class="payment-summary mb-4">
            <div class="text-uppercase font-weight-bold mb-3" style="letter-spacing:1px;font-size:.75rem;opacity:.8;">
                <i class="fas fa-receipt mr-1"></i>Booking Summary
            </div>
            <div class="d-flex align-items-center mb-3">
                <div class="mr-3"><i class="fas fa-car fa-2x"></i></div>
                <div>
                    <div class="font-weight-bold" style="font-size:1.1rem;">{{ reservation.voiture.marque }} {{ reservation.voiture.modele }}</div>
                    <div style="opacity:.75;font-size:.85rem;">Booking #{{ reservation.id }}</div>
                </div>
            </div>
            <hr style="border-color:rgba(255,255,255,.15);">
            <div class="d-flex justify-content-between mb-2">
                <span style="opacity:.8;"><i class="fas fa-calendar-day mr-1"></i>Pick-up</span>
                <strong>{{ reservation.dateDebut|date('d/m/Y') }}</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span style="opacity:.8;"><i class="fas fa-calendar-day mr-1"></i>Return</span>
                <strong>{{ reservation.dateFin|date('d/m/Y') }}</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span style="opacity:.8;"><i class="fas fa-sun mr-1"></i>Duration</span>
                <strong>
                    {% set days = (reservation.dateFin.timestamp - reservation.dateDebut.timestamp) / 86400 + 1 %}
                    {{ days|round(0,'ceil') }} day(s)
                </strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span style="opacity:.8;"><i class="fas fa-tag mr-1"></i>Price/day</span>
                <strong>{{ reservation.voiture.prixParJour }} DT</strong>
            </div>
            <hr style="border-color:rgba(255,255,255,.15);">
            <div class="d-flex justify-content-between align-items-center">
                <span class="font-weight-bold" style="font-size:1rem;">Total</span>
                <span class="price-total">{{ reservation.prixTotal|number_format(2, ',', ' ') }} <small>DT</small></span>
            </div>
        </div>

        <div class="cr-panel cr-panel-body">
            <div class="d-flex align-items-center">
                <i class="fas fa-envelope fa-2x mr-3" style="color: var(--cr-success);"></i>
                <div>
                    <div class="font-weight-bold" style="font-size:.85rem;">Confirmation email</div>
                    <div class="small" style="color: var(--cr-gray-300);">An email will be sent to <strong>{{ app.user.email }}</strong> once confirmed.</div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</section>
{% endblock %}

{% block javascripts %}
<script>
document.getElementById('cardNumber')?.addEventListener('input', function(e) {
    let v = e.target.value.replace(/\D/g, '').substring(0, 19);
    e.target.value = v.match(/.{1,4}/g)?.join(' ') || v;
});
document.getElementById('cardHolder')?.addEventListener('input', function(e) {
    e.target.value = e.target.value.toUpperCase();
});
</script>
{% endblock %}
