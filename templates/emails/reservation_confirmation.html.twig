<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Confirmation de réservation — CarRent</title>
</head>
<body style="margin:0;padding:0;background:#f4f6fb;font-family:'Helvetica Neue',Arial,sans-serif;color:#2e3338;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6fb;padding:30px 0;">
<tr><td align="center">

  <!-- Container -->
  <table width="620" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">

    <!-- Header -->
    <tr>
      <td style="background:linear-gradient(135deg,#2a33a3 0%,#1a237e 100%);padding:36px 40px;text-align:center;">
        <table width="100%" cellpadding="0" cellspacing="0">
          <tr>
            <td align="center">
              <div style="display:inline-block;background:rgba(255,255,255,0.15);border-radius:50%;width:64px;height:64px;line-height:64px;text-align:center;margin-bottom:14px;">
                <span style="font-size:28px;">🚗</span>
              </div>
              <div style="font-size:28px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;">CarRent</div>
              <div style="font-size:13px;color:rgba(255,255,255,0.75);margin-top:4px;">Location de Voitures — Tunisie</div>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Success Banner -->
    <tr>
      <td style="background:#1cc88a;padding:18px 40px;text-align:center;">
        <span style="font-size:16px;font-weight:700;color:#ffffff;">
          ✅ &nbsp; Réservation Confirmée — Réf. #{{ '%05d'|format(reservation.id) }}
        </span>
      </td>
    </tr>

    <!-- Greeting -->
    <tr>
      <td style="padding:36px 40px 20px;">
        <p style="font-size:18px;font-weight:700;margin:0 0 8px;">Bonjour {{ client.nom }},</p>
        <p style="font-size:15px;color:#555;margin:0;line-height:1.6;">
          Nous vous confirmons que votre réservation a été enregistrée et votre paiement accepté avec succès.
          Vous trouverez ci-dessous le récapitulatif complet de votre location.
        </p>
      </td>
    </tr>

    <!-- Car Info Box -->
    <tr>
      <td style="padding:0 40px 20px;">
        <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f9fc;border-radius:10px;border:1px solid #e3e6f0;overflow:hidden;">
          <tr>
            <td style="background:linear-gradient(135deg,#2a33a3,#1a237e);padding:14px 20px;">
              <span style="font-size:14px;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:1px;">
                🚗 Véhicule loué
              </span>
            </td>
          </tr>
          <tr>
            <td style="padding:20px;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="50%" style="font-size:22px;font-weight:800;color:#2a33a3;">
                    {{ voiture.marque }} {{ voiture.modele }}
                  </td>
                  <td width="50%" align="right" style="font-size:14px;color:#555;">
                    <span style="background:#e8f4fd;color:#2a33a3;padding:4px 12px;border-radius:20px;font-weight:600;">
                      {{ voiture.prixParJour }} DT / jour
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Reservation Details -->
    <tr>
      <td style="padding:0 40px 20px;">
        <table width="100%" cellpadding="0" cellspacing="0" style="border-radius:10px;border:1px solid #e3e6f0;overflow:hidden;">
          <tr>
            <td style="background:#f8f9fc;padding:14px 20px;border-bottom:1px solid #e3e6f0;">
              <span style="font-size:14px;font-weight:700;color:#2e3338;text-transform:uppercase;letter-spacing:1px;">
                📋 Détails de la location
              </span>
            </td>
          </tr>
          <tr>
            <td style="padding:0;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr style="border-bottom:1px solid #f1f3f9;">
                  <td style="padding:14px 20px;font-size:14px;color:#858796;width:45%;">📅 Date de début</td>
                  <td style="padding:14px 20px;font-size:14px;font-weight:700;color:#2e3338;">{{ reservation.dateDebut|date('d/m/Y') }}</td>
                </tr>
                <tr style="border-bottom:1px solid #f1f3f9;">
                  <td style="padding:14px 20px;font-size:14px;color:#858796;">📅 Date de fin</td>
                  <td style="padding:14px 20px;font-size:14px;font-weight:700;color:#2e3338;">{{ reservation.dateFin|date('d/m/Y') }}</td>
                </tr>
                <tr style="border-bottom:1px solid #f1f3f9;">
                  <td style="padding:14px 20px;font-size:14px;color:#858796;">🌙 Durée</td>
                  <td style="padding:14px 20px;font-size:14px;font-weight:700;color:#2e3338;">{{ days }} jour(s)</td>
                </tr>
                <tr style="border-bottom:1px solid #f1f3f9;">
                  <td style="padding:14px 20px;font-size:14px;color:#858796;">👤 Client</td>
                  <td style="padding:14px 20px;font-size:14px;font-weight:700;color:#2e3338;">{{ client.nom }}</td>
                </tr>
                <tr>
                  <td style="padding:14px 20px;font-size:14px;color:#858796;">✉️ Email</td>
                  <td style="padding:14px 20px;font-size:14px;font-weight:700;color:#2e3338;">{{ client.email }}</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Pricing Summary -->
    <tr>
      <td style="padding:0 40px 30px;">
        <table width="100%" cellpadding="0" cellspacing="0" style="background:linear-gradient(135deg,#2a33a3,#1a237e);border-radius:10px;overflow:hidden;">
          <tr>
            <td style="padding:20px 24px;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="font-size:13px;color:rgba(255,255,255,0.75);">{{ voiture.prixParJour }} DT × {{ days }} jour(s)</td>
                  <td align="right" style="font-size:13px;color:rgba(255,255,255,0.75);">{{ reservation.prixTotal }} DT</td>
                </tr>
                <tr>
                  <td colspan="2" style="border-top:1px solid rgba(255,255,255,0.2);padding-top:12px;margin-top:12px;">&nbsp;</td>
                </tr>
                <tr>
                  <td style="font-size:18px;font-weight:800;color:#ffffff;">💳 Total payé</td>
                  <td align="right" style="font-size:26px;font-weight:800;color:#ffffff;">{{ reservation.prixTotal|number_format(2, ',', ' ') }} DT</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Info Box -->
    <tr>
      <td style="padding:0 40px 30px;">
        <table width="100%" cellpadding="0" cellspacing="0" style="background:#e8f4fd;border-left:4px solid #2a33a3;border-radius:0 8px 8px 0;padding:0;">
          <tr>
            <td style="padding:16px 20px;font-size:14px;color:#2a33a3;line-height:1.6;">
              <strong>ℹ️ Informations importantes :</strong><br>
              Veuillez vous présenter à notre agence le jour de votre prise en charge avec une pièce d'identité valide
              et votre permis de conduire. Référence de réservation : <strong>#{{ '%05d'|format(reservation.id) }}</strong>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Footer -->
    <tr>
      <td style="background:#f8f9fc;padding:24px 40px;border-top:1px solid #e3e6f0;text-align:center;">
        <p style="font-size:13px;color:#858796;margin:0 0 8px;">
          Merci de votre confiance. Pour toute question, contactez-nous à
          <a href="mailto:contact@carrent.tn" style="color:#2a33a3;">contact@carrent.tn</a>
        </p>
        <p style="font-size:12px;color:#b7b9cc;margin:0;">
          © {{ "now"|date("Y") }} CarRent — Gestion de Location de Voitures, Tunisie<br>
          Cet email est automatiquement généré, merci de ne pas y répondre directement.
        </p>
      </td>
    </tr>

  </table>

</td></tr>
</table>
</body>
</html>
