{% extends 'base.html.twig' %}

{% block title %}Inscription — CarRent{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-plus mr-2"></i>Créer un Compte
                    </h4>
                </div>
                <div class="card-body p-5">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle mr-2"></i>{{ message }}
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-triangle mr-2"></i>{{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">
                            <i class="fas fa-user-tag mr-1 text-primary"></i>Nom d'utilisateur
                        </label>
                        {{ form_widget(form.username, {'attr': {'class': 'form-control', 'placeholder': 'Choisissez un nom d\'utilisateur...'}}) }}
                        {{ form_errors(form.username) }}
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">
                            <i class="fas fa-user mr-1 text-primary"></i>Nom Complet
                        </label>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom...'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">
                            <i class="fas fa-envelope mr-1 text-primary"></i>Email
                        </label>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com', 'type': 'email'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-700">
                            <i class="fas fa-lock mr-1 text-primary"></i>Mot de Passe
                        </label>
                        {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Entrez un mot de passe sécurisé...'}}) }}
                        {{ form_errors(form.password) }}
                        <small class="text-muted d-block mt-2">
                            <i class="fas fa-info-circle mr-1"></i>Le mot de passe doit contenir au moins 6 caractères.
                        </small>
                    </div>

                    <hr class="my-4">

                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-save mr-1"></i>S'inscrire
                    </button>

                    {{ form_end(form) }}

                    <hr class="my-3">

                    <p class="text-center text-muted">
                        Vous avez déjà un compte?
                        <a href="{{ path('app_login') }}">Se connecter</a>
                    </p>
                </div>
        </div>
</div>
{% endblock %}
