{% extends 'base_public.html.twig' %}

{% block title %}Create an account{% endblock %}

{% block body %}
<div class="lx-auth">
    <aside class="lx-auth__visual" aria-hidden="true">
        <img src="{{ asset('images/hero-showroom.jpg') }}" alt="">
        <div class="lx-auth__quote">
            <span class="eyebrow eyebrow--rule">Sayara</span>
            <p>Exceptional cars, <em>simply rented</em>.</p>
        </div>
    </aside>

    <section class="lx-auth__panel">
        <div class="lx-auth__form cr-reveal cr-visible">
            <span class="eyebrow eyebrow--rule">Join Sayara</span>
            <h1 class="display">Create an <em>account</em></h1>
            <p class="lede mb-5">One account for every booking you make.</p>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="form-group lx-field">
                    {{ form_label(form.username, 'Username') }}
                    {{ form_widget(form.username, {'attr': {'class': 'lx-input', 'autocomplete': 'username'}}) }}
                    {{ form_errors(form.username) }}
                </div>
                <div class="form-group lx-field">
                    {{ form_label(form.nom, 'Full name') }}
                    {{ form_widget(form.nom, {'attr': {'class': 'lx-input', 'autocomplete': 'name'}}) }}
                    {{ form_errors(form.nom) }}
                </div>
                <div class="form-group lx-field">
                    {{ form_label(form.email, 'Email') }}
                    {{ form_widget(form.email, {'attr': {'class': 'lx-input', 'autocomplete': 'email'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="form-group lx-field">
                    {{ form_label(form.password, 'Password') }}
                    {{ form_widget(form.password, {'attr': {'class': 'lx-input', 'autocomplete': 'new-password', 'placeholder': 'At least 8 characters'}}) }}
                    {{ form_errors(form.password) }}
                </div>
                <button type="submit" class="btn-lx btn-lx--gold btn-lx--block mt-2">Create account</button>
            {{ form_end(form) }}

            <p class="lx-auth__switch">Already have an account? <a href="{{ path('app_login') }}">Sign in</a></p>
        </div>
    </section>
</div>
{% endblock %}
