{% extends 'base_public.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="cr-auth-wrap">
    <div class="container">
        <div class="cr-auth-card cr-reveal cr-visible">
            <div class="text-center mb-4">
                <i class="fas fa-car fa-2x mb-2" style="color: var(--cr-gray-300);"></i>
                <h2 class="font-weight-bold mb-0">Create Your Account</h2>
                <p class="text-muted small">Join CarRent to start booking</p>
            </div>

            <div class="cr-panel cr-panel-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="form-group">
                    <label>Username</label>
                    {{ form_widget(form.username, {'attr': {'class': 'form-control cr-input', 'placeholder': 'Choose a username...'}}) }}
                    {{ form_errors(form.username) }}
                </div>

                <div class="form-group">
                    <label>Full Name</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control cr-input', 'placeholder': 'Your full name...'}}) }}
                    {{ form_errors(form.nom) }}
                </div>

                <div class="form-group">
                    <label>Email</label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control cr-input', 'placeholder': 'you@example.com', 'type': 'email'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="form-group">
                    <label>Password</label>
                    {{ form_widget(form.password, {'attr': {'class': 'form-control cr-input', 'placeholder': 'At least 8 characters...'}}) }}
                    {{ form_errors(form.password) }}
                </div>

                <button type="submit" class="btn-cr-primary w-100 mt-3">
                    <i class="fas fa-user-plus mr-2"></i>Create Account
                </button>

                {{ form_end(form) }}
            </div>

            <p class="text-center small mt-3" style="color: var(--cr-gray-300);">
                Already have an account? <a href="{{ path('app_login') }}" class="font-weight-bold text-white">Sign in</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
