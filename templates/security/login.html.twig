{% extends 'base_public.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
<div class="lx-auth">
    <aside class="lx-auth__visual" aria-hidden="true">
        <img src="{{ asset('images/hero-showroom.jpg') }}" alt="">
        <div class="lx-auth__quote">
            <span class="eyebrow eyebrow--rule">Sayara</span>
            <p>Your next drive is <em>already waiting</em>.</p>
        </div>
    </aside>

    <section class="lx-auth__panel">
        <div class="lx-auth__form cr-reveal cr-visible">
            <span class="eyebrow eyebrow--rule">Welcome back</span>
            <h1 class="display">Sign <em>in</em></h1>
            <p class="lede mb-5">Access your bookings and reserve your next car.</p>

            {% if error %}
                <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form action="{{ path('app_login') }}" method="post">
                <div class="form-group lx-field">
                    <label for="username">Username</label>
                    <input type="text" class="lx-input" id="username" name="username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </div>
                <div class="form-group lx-field">
                    <label for="password">Password</label>
                    <input type="password" class="lx-input" id="password" name="password" autocomplete="current-password" required>
                </div>
                <div class="custom-control custom-checkbox mb-5">
                    <input type="checkbox" class="custom-control-input" id="rememberMe" name="_remember_me">
                    <label class="custom-control-label" for="rememberMe">Keep me signed in</label>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn-lx btn-lx--gold btn-lx--block">Sign in</button>
            </form>

            <p class="lx-auth__switch">New to Sayara? <a href="{{ path('app_signup') }}">Create an account</a></p>
        </div>
    </section>
</div>
{% endblock %}
